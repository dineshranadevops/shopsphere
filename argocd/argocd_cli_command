
#Linux AMD64 CLI install

curl -sSL -o /tmp/argocd-linux-amd64 \
  https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64

chmod +x /tmp/argocd-linux-amd64

sudo mv /tmp/argocd-linux-amd64 /usr/local/bin/argocd

argocd version --client

#Argo CD server ke saath CLI connect

kubectl port-forward --address 0.0.0.0 \
  -n argocd svc/argocd-server 8443:443

#password of argocd 

kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath="{.data.password}" | base64 -d; echo

# run on  other terminal

argocd login localhost:8443 \
  --username admin \
  --password '<YOUR_PASSWORD>' \
  --insecure

# login verify

argocd account get-user-info

argocd app list

#Ab ShopSphere deploy kar sakte ho

argocd app sync shopsphere-dev

# status of application 

argocd app get shopsphere-dev

# health status

argocd app wait shopsphere-dev \
  --sync \
  --health \
  --timeout 300

 kubectl get pods -n shopsphere

#Auto Sync CLI se enable

argocd app set shopsphere-dev --sync-policy automated

#check auto sync

argocd app get shopsphere-dev

#Sirf Argo CD Application delete

argocd app delete shopsphere-dev

#Agar aapka objective sirf Argo CD se Application hatana hai aur workloads ko running rakhna hai, safer approach:

argocd app delete shopsphere-dev --cascade=false



